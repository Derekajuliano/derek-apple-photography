{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "derek-apple-photography",
  "main": "./worker.js",
  "compatibility_date": "2026-08-09",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/contact"
    ]
  },

  "secrets": {
    "required": [
      "RESEND_API_KEY"
    ]
  }
}
